# 复制为 /etc/boguan/ops.env，root:xun 0640；不提交真实凭证。
# systemd EnvironmentFile 格式，不使用 export，也不会被 shell source。
BOGUAN_APP=/home/xun/boguan
BOGUAN_BACKUP_DIR=/home/xun/backups
BOGUAN_PUBLIC_URL=https://boguan.org.cn
BOGUAN_LOCAL_URL=http://127.0.0.1:4321

# generic / feishu / dingtalk / wecom / slack；不要填有签名校验但未适配的 webhook。
BOGUAN_ALERT_FORMAT=generic
BOGUAN_ALERT_WEBHOOK=

# 私有 OSS bucket；ossutil 配置通过 ossutil config 在服务器上生成，权限 0600。
BOGUAN_OSS_BUCKET=
OSSUTIL_CONFIG=/etc/boguan/ossutilconfig
