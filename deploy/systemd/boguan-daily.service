[Unit]
Description=Boguan daily crawl + rebuild + switch
After=network-online.target boguan-web.service
Wants=network-online.target

[Service]
Type=oneshot
User=xun
Group=xun
WorkingDirectory=/home/xun/boguan
ExecStart=/home/xun/ops/daily.sh
TimeoutStartSec=1800
Nice=10
StandardOutput=journal
StandardError=journal