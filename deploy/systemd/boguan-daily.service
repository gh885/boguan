[Unit]
Description=Boguan daily crawl + verified release
After=network-online.target boguan-web.service
Wants=network-online.target
OnFailure=boguan-alert@%n.service

[Service]
Type=oneshot
User=xun
Group=xun
WorkingDirectory=/home/xun/boguan
EnvironmentFile=-/etc/boguan/ops.env
ExecStart=/bin/bash /home/xun/ops/daily.sh
TimeoutStartSec=1800
TimeoutStopSec=150
KillMode=control-group
Nice=10
UMask=0022
StandardOutput=journal
StandardError=journal
