[Unit]
Description=Boguan web (static pages + SSR search)
After=network-online.target
Wants=network-online.target
OnFailure=boguan-alert@%n.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=boguan-web
Group=boguan-web
WorkingDirectory=/srv/boguan
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4321
Environment=BOGUAN_DB=/srv/boguan/data/boguan.db
Environment=NODE_OPTIONS=--max-old-space-size=256
ExecStart=/usr/local/bin/node /srv/boguan/dist/server/entry.mjs
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
BindReadOnlyPaths=/home/xun/boguan:/srv/boguan
InaccessiblePaths=/srv/boguan/data/bodies -/srv/boguan/.git -/srv/boguan/.ops -/srv/boguan/.env -/srv/boguan/.env.production -/etc/boguan
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryHigh=384M
MemoryMax=512M
TasksMax=128
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
