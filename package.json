{
  "name": "boguan",
  "version": "0.0.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "preview": "bun run --cwd apps/web preview",
    "astro": "bun run --cwd apps/web astro",
    "i18n:check": "x18n check",
    "i18n:ui": "x18n ui",
    "prepare": "vp config",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:init": "bun apps/ops/src/init.ts",
    "db:seed": "bun apps/ops/src/seed.ts",
    "db:check": "bun apps/ops/src/check.ts",
    "db:curate": "bun apps/ops/src/curate.ts",
    "db:metrics": "bun apps/ops/src/metrics.ts",
    "db:fixture": "bun apps/ops/src/fixture.ts",
    "crawl": "bun apps/crawler/src/cli.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "^1.4.5",
    "@types/node": "^26.6.6",
    "@x18n/cli": "^0.1.4",
    "@x18n/core": "^0.1.4",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.11",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "download"
    }
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "trustedDependencies": [
    "esbuild"
  ]
}
