---
interface Company {
	name: string;
	slug: string;
	logoUrl?: string | null;
}

interface Props {
	company: Company;
	size?: "sm" | "md" | "lg";
	/** 英文界面传 nameEn；只影响占位首字母 */
	label?: string;
}

const { company, size = "sm", label } = Astro.props;
const initial = Array.from((label ?? company.name).trim())[0] ?? "?";
const src = company.logoUrl?.trim();
---

<span class:list={["company-logo", `company-logo--${size}`]} aria-hidden="true">
	{
		src ? (
			<img src={src} alt="" width="32" height="32" loading="lazy" decoding="async" />
		) : (
			<span class="company-logo__initial">{initial}</span>
		)
	}
</span>

<style>
	.company-logo {
		display: inline-flex;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		background-color: var(--color-surface-muted);
		color: var(--color-text-secondary);
	}

	.company-logo--sm {
		width: 20px;
		height: 20px;
	}

	.company-logo--md {
		width: 26px;
		height: 26px;
	}

	.company-logo--lg {
		width: 34px;
		height: 34px;
		border-radius: var(--radius-md);
	}

	.company-logo img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		padding: 2px;
	}

	.company-logo__initial {
		font-size: 0.625rem;
		font-weight: var(--weight-semibold);
		line-height: 1;
		text-transform: uppercase;
	}

	.company-logo--md .company-logo__initial {
		font-size: 0.6875rem;
	}

	.company-logo--lg .company-logo__initial {
		font-size: 0.8125rem;
	}
</style>
