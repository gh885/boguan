---
import type { CompanyCard, PostCard as PostCardData, TagCard } from "../lib/db/queries";
import { formatCount, localizePath, useTranslations } from "../lib/i18n";
import { companyDisplayName } from "../lib/i18n/company";
import type { Locale } from "../lib/i18n/config";
import { INDEX_PAGE_SIZE } from "../lib/pagination";
import { searchHref } from "../lib/search-url";
import type { IndexFacetGroup, IndexRailModule } from "../lib/index-sheet";
import IndexSheet from "./IndexSheet.astro";

interface Props {
  locale: Locale;
  company: CompanyCard;
  topTags: TagCard[];
  years: { year: number; count: number }[];
  posts: PostCardData[];
  total: number;
  page: number;
  totalPages: number;
  prevHref?: string;
  nextHref?: string;
  navYearsHref?: string;
}

const {
  locale,
  company,
  topTags,
  years,
  posts,
  total,
  page,
  totalPages,
  prevHref,
  nextHref,
  navYearsHref,
} = Astro.props;
const t = useTranslations(locale);
const name = companyDisplayName(company, locale);

const facets: IndexFacetGroup[] = [
  {
    label: t("filter.label"),
    items: [
      {
        label: t("filter.hasCode"),
        href: searchHref(locale, { company: company.slug, has_code: true }),
      },
    ],
  },
];

if (years.length > 1) {
  facets.push({
    label: t("nav.years"),
    items: years.map((entry) => ({
      label: String(entry.year),
      count: entry.count,
      href: searchHref(locale, { company: company.slug, year: entry.year }),
    })),
  });
}

const rail: IndexRailModule[] = [];

if (topTags.length > 0) {
  rail.push({
    title: t("company.topTechnologies"),
    links: topTags.map((tag) => ({
      label: tag.name,
      href: localizePath(`/tag/${tag.slug}`, locale),
      count: tag.count,
      lang: locale === "en" ? "zh-CN" : undefined,
    })),
    allHref: localizePath("/tags", locale),
    allLabel: t("nav.viewAllTags"),
  });
}

rail.push({
  title: t("index.companyLinks"),
  links: company.homepage
    ? [{ label: t("index.companyHomepage"), href: company.homepage }]
    : [],
  allHref: localizePath("/companies", locale),
  allLabel: t("nav.viewAllCompanies"),
});
---

<IndexSheet
	locale={locale}
	kicker={t("index.kicker.company")}
	current="companies"
	title={name}
	titleLang={locale === "en" && !company.nameEn ? "zh-CN" : undefined}
	facts={[formatCount(locale, "articles", total)]}
	posts={posts}
	total={total}
	page={page}
	totalPages={totalPages}
	prevHref={prevHref}
	nextHref={nextHref}
	pageSize={INDEX_PAGE_SIZE}
	facets={facets}
	rail={rail}
	emptyTitle={t("company.empty")}
	navYearsHref={navYearsHref}
/>
