---
import { useTranslations } from "../lib/i18n";
import type { Locale } from "../lib/i18n/config";
import Icon from "./Icon.astro";

interface Props {
	locale: Locale;
	active?: boolean;
	/** 点「含代码」要去的地方（静态列表页指向 SSR 搜索，搜索页则切换当前条件） */
	href: string;
	clearHref?: string;
}

const { locale, active = false, href, clearHref } = Astro.props;
const t = useTranslations(locale);
---

<div class="filter-bar">
	<span class="filter-bar__label">
		<Icon name="filter" size={12} />
		<span>{t("filter.label")}</span>
	</span>
	<a class:list={["filter-bar__chip", { "is-active": active }]} href={href} aria-current={active ? "true" : undefined}>
		<Icon name="code" size={12} />
		<span>{t("filter.hasCode")}</span>
	</a>
	{
		active && clearHref && (
			<a class="filter-bar__clear" href={clearHref}>
				<Icon name="close" size={11} />
				<span>{t("filter.clear")}</span>
			</a>
		)
	}
</div>

<style>
	.filter-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35rem;
		color: var(--color-text-secondary);
		font-size: var(--text-xs);
	}

	.filter-bar__label {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		margin-inline-end: 0.1rem;
	}

	.filter-bar__chip,
	.filter-bar__clear {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		min-height: 2rem;
		padding: 0.2rem 0.55rem;
		border: 1px solid transparent;
		border-radius: var(--radius-sm);
		color: var(--color-text-secondary);
		text-decoration: none;
		transition: background-color var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
	}

	.filter-bar__chip:hover {
		border-color: var(--color-border);
		background-color: var(--color-surface-muted);
		color: var(--color-accent);
		text-decoration: none;
	}

	.filter-bar__chip.is-active {
		border-color: color-mix(in oklab, var(--color-accent) 35%, var(--color-border));
		background-color: color-mix(in oklab, var(--color-accent) 10%, var(--color-surface));
		color: var(--color-accent);
	}

	.filter-bar__clear {
		color: var(--color-text-secondary);
	}

	.filter-bar__clear:hover {
		color: var(--color-text-primary);
		text-decoration: none;
	}
</style>
