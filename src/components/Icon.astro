---
/**
 * 内联图标（lucide 风格的线性图标）。不引图标库：需要的十几个路径手写更轻，
 * 也不会因为运行时依赖多一个包。颜色一律 currentColor，尺寸由调用方给。
 */
import type { IconName } from "../lib/icons";

interface Props {
	name: IconName;
	size?: number;
	strokeWidth?: number;
}

const { name, size = 16, strokeWidth = 1.8 } = Astro.props;
---

<svg
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width={strokeWidth}
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
>
	{name === "arrow-left" && <Fragment><path d="M19 12H5" /><path d="m12 19-7-7 7-7" /></Fragment>}
	{name === "arrow-right" && <Fragment><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></Fragment>}
	{
		name === "code" && (
			<Fragment>
				<polyline points="16 18 22 12 16 6" />
				<polyline points="8 6 2 12 8 18" />
			</Fragment>
		)
	}
	{name === "search" && <Fragment><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></Fragment>}
</svg>
