---
/**
 * 内联图标（lucide 风格的线性图标）。不引图标库：需要的十几个路径手写更轻，
 * 也不会因为运行时依赖多一个包。颜色一律 currentColor，尺寸由调用方给。
 */
import type { IconName } from "../lib/icons";

interface Props {
	name: IconName;
	size?: number;
	strokeWidth?: number;
}

const { name, size = 16, strokeWidth = 1.8 } = Astro.props;
---

<svg
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width={strokeWidth}
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
>
	{name === "arrow-left" && <Fragment><path d="M19 12H5" /><path d="m12 19-7-7 7-7" /></Fragment>}
	{name === "arrow-right" && <Fragment><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></Fragment>}
	{
		name === "building" && (
			<Fragment>
				<path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z" />
				<path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2" />
				<path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2" />
				<path d="M10 6h4M10 10h4M10 14h4M10 18h4" />
			</Fragment>
		)
	}
	{
		name === "calendar" && (
			<Fragment>
				<rect x="3" y="4" width="18" height="18" rx="2" />
				<path d="M16 2v4M8 2v4M3 10h18" />
			</Fragment>
		)
	}
	{name === "check" && <path d="M20 6 9 17l-5-5" />}
	{name === "chevron-right" && <path d="m9 18 6-6-6-6" />}
	{
		name === "clock" && (
			<Fragment>
				<circle cx="12" cy="12" r="9" />
				<path d="M12 7v5l3 2" />
			</Fragment>
		)
	}
	{name === "close" && <Fragment><path d="M18 6 6 18" /><path d="m6 6 12 12" /></Fragment>}
	{
		name === "code" && (
			<Fragment>
				<polyline points="16 18 22 12 16 6" />
				<polyline points="8 6 2 12 8 18" />
			</Fragment>
		)
	}
	{name === "external" && <Fragment><path d="M7 17 17 7" /><path d="M7 7h10v10" /></Fragment>}
	{
		name === "filter" && (
			<path d="M10 20a1 1 0 0 0 .553.895l2 1A1 1 0 0 0 14 21v-7a2 2 0 0 1 .517-1.341L21.74 4.67A1 1 0 0 0 21 3H3a1 1 0 0 0-.742 1.67l7.225 7.989A2 2 0 0 1 10 14z" />
		)
	}
	{name === "hash" && <Fragment><path d="M4 9h16M4 15h16M10 3 8 21M16 3l-2 18" /></Fragment>}
	{name === "home" && <Fragment><path d="m3 10 9-7 9 7v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" /><path d="M9 21v-7h6v7" /></Fragment>}
	{
		name === "mail" && (
			<Fragment>
				<rect x="2" y="4" width="20" height="16" rx="2" />
				<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
			</Fragment>
		)
	}
	{name === "menu" && <path d="M3 6h18M3 12h18M3 18h18" />}
	{
		name === "rss" && (
			<Fragment>
				<path d="M4 11a9 9 0 0 1 9 9" />
				<path d="M4 4a16 16 0 0 1 16 16" />
				<circle cx="5" cy="19" r="1" />
			</Fragment>
		)
	}
	{name === "search" && <Fragment><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></Fragment>}
	{
		name === "sparkles" && (
			<Fragment>
				<path d="m12 3 1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9Z" />
				<path d="M19 15v4M17 17h4M5 3v4M3 5h4" />
			</Fragment>
		)
	}
</svg>
