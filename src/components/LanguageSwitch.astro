---
import { alternateLinks, useTranslations } from "../lib/i18n";
import { localeLabels } from "../lib/i18n/config";
import type { Locale } from "../lib/i18n/config";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const links = alternateLinks(Astro.url.pathname);
---

<nav class="language-switch" aria-label={t("nav.language")}>
	<ul>
		{
			links.map((link) => (
				<li>
					<a
						href={link.href}
						hreflang={link.hreflang}
						lang={link.hreflang}
						aria-label={t("language.switchTo", { language: localeLabels[link.locale] })}
						aria-current={link.locale === locale ? "true" : undefined}
					>
						{localeLabels[link.locale]}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	.language-switch ul {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.language-switch a {
		color: var(--color-text-secondary);
		font-size: var(--text-sm);
		text-decoration: none;
	}

	.language-switch a:hover {
		color: var(--color-accent);
		text-decoration: underline;
	}

	.language-switch a[aria-current="true"] {
		color: var(--color-text-primary);
		font-weight: var(--weight-semibold);
	}
</style>
