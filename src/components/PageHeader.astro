---
import type { Locale } from "../lib/i18n/config";
import CompanyLogo from "./CompanyLogo.astro";
import type { IconName } from "../lib/icons";
import Icon from "./Icon.astro";
import SearchForm from "./SearchForm.astro";

interface Company {
	name: string;
	slug: string;
	logoUrl?: string | null;
}

interface Props {
	locale: Locale;
	title: string;
	description?: string;
	meta?: string;
	icon?: IconName;
	logo?: Company;
	searchValue?: string;
	searchHidden?: Record<string, string>;
	searchClearHref?: string;
	showSearch?: boolean;
}

const {
	locale,
	title,
	description,
	meta,
	icon,
	logo,
	searchValue = "",
	searchHidden = {},
	searchClearHref,
	showSearch = true,
} = Astro.props;
---

<header class="page-header">
	<div class="page-header__text">
		<div class="page-header__title-row">
			{logo && <CompanyLogo company={logo} size="lg" />}
			{icon && !logo && (
				<span class="page-header__icon" aria-hidden="true"><Icon name={icon} size={22} /></span>
			)}
			<h1>{title}</h1>
		</div>
		{description && <p class="page-header__description">{description}</p>}
		{meta && <p class="page-header__meta">{meta}</p>}
	</div>
	{
		showSearch && (
			<div class="page-header__search">
				<SearchForm
					locale={locale}
					value={searchValue}
					hidden={searchHidden}
					clearHref={searchClearHref}
				/>
			</div>
		)
	}
</header>

<style>
	.page-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--space-lg);
		padding-block-end: 1.25rem;
		border-block-end: 1px solid var(--color-border);
	}

	.page-header__text {
		min-width: 0;
	}

	.page-header__title-row {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		min-width: 0;
	}

	.page-header h1 {
		margin: 0;
		font-size: var(--text-3xl);
		font-weight: var(--weight-bold);
		line-height: 1.18;
		letter-spacing: var(--tracking-tight);
	}

	.page-header__icon {
		display: inline-flex;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		color: var(--color-text-secondary);
	}

	.page-header__description {
		max-width: 48rem;
		margin: 0.55rem 0 0;
		color: var(--color-text-secondary);
		font-size: var(--text-sm);
		line-height: 1.55;
	}

	.page-header__meta {
		margin: 0.35rem 0 0;
		color: var(--color-text-secondary);
		font-size: var(--text-xs);
	}

	.page-header__search {
		flex-shrink: 0;
		padding-block-start: 0.15rem;
	}

	@media (max-width: 767px) {
		.page-header {
			flex-direction: column;
			gap: 0.9rem;
			padding-block-end: 1rem;
		}

		.page-header__search {
			width: 100%;
			padding-block-start: 0;
		}
	}
</style>
