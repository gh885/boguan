---
import { useTranslations } from "../lib/i18n";
import type { Locale } from "../lib/i18n/config";

interface Props {
  locale: Locale;
  /** 版头眉批，例如「标签 / TOPIC」；由页面传本地化文案。 */
  kicker: string;
  title: string;
  titleLang?: string;
  facts?: string[];
  /** 标题下的一句补充，例如目录页的排序说明。 */
  description?: string;
  clearHref?: string;
  clearLabel?: string;
}

const {
  locale,
  kicker,
  title,
  titleLang,
  facts = [],
  description,
  clearHref,
  clearLabel,
} = Astro.props;
const t = useTranslations(locale);
---

<header class="paper-secthead">
	<p class="paper-kicker">{kicker}</p>
	<div class="paper-headrow">
		<h1 class="paper-title" id="paper-title" lang={titleLang}>{title}</h1>
		<div class="paper-headmeta">
			{facts.length > 0 && <p class="paper-facts">{facts.join(" · ")}</p>}
			{
				clearHref && (
					<a class="paper-clear" href={clearHref}>
						{clearLabel ?? t("search.clear")}
					</a>
				)
			}
		</div>
	</div>
	{description && <p class="paper-description">{description}</p>}
</header>
<div class="paper-sectrule"></div>
