---
import type { PostCard as PostCardData } from "../lib/db/queries";
import { formatDate, localizePath, useTranslations } from "../lib/i18n";
import { companyDisplayName } from "../lib/i18n/company";
import type { Locale } from "../lib/i18n/config";
import CompanyLogo from "./CompanyLogo.astro";
import Icon from "./Icon.astro";

interface Props {
	post: PostCardData;
	locale: Locale;
}

const { post, locale } = Astro.props;
const t = useTranslations(locale);
const companyHref = localizePath(`/company/${post.companySlug}`, locale);
const contentLang = post.lang && post.lang !== locale ? post.lang : undefined;
const companyName = companyDisplayName(
	{ name: post.companyName, nameEn: post.companyNameEn },
	locale,
);
---

<article class="post-card">
	<div class="post-card__top">
		<a class="post-card__company" href={companyHref}>
			<CompanyLogo
				company={{ name: post.companyName, slug: post.companySlug, logoUrl: post.companyLogoUrl }}
				size="sm"
				label={companyName}
			/>
			<span lang={locale === "en" && post.companyNameEn ? "en" : contentLang}>{companyName}</span>
		</a>
		<a
			class="post-card__external"
			href={post.url}
			target="_blank"
			rel="noopener noreferrer"
			aria-label={t("card.original")}
			title={post.title}
		>
			<Icon name="external" size={15} />
		</a>
	</div>

	<h3 class="post-card__title" lang={contentLang}>
		<a href={post.url} target="_blank" rel="noopener noreferrer">{post.title}</a>
	</h3>

	<p class="post-card__summary" lang={contentLang}>{post.summary}</p>

	{
		post.tags.length > 0 && (
			<ul class="post-card__tags" aria-label={t("card.tags")}>
				{post.tags.map((tag) => (
					<li>
						<a href={localizePath(`/tag/${tag.slug}`, locale)} lang={contentLang}>{tag.name}</a>
					</li>
				))}
			</ul>
		)
	}

	<footer class="post-card__footer">
		<div class="post-card__meta">
			{post.author && <span class="post-card__author" lang={contentLang}>{post.author}</span>}
			{
				post.readingMinutes !== null && (
					<span class="post-card__meta-item">
						<Icon name="clock" size={13} />
						<span>{t("card.readingTime", { minutes: post.readingMinutes })}</span>
					</span>
				)
			}
			{
				post.hasCode === true && (
					<span class="post-card__meta-item">
						<Icon name="code" size={13} />
						<span>{t("card.includesCode")}</span>
					</span>
				)
			}
		</div>
		{
			post.publishedAt && (
				<time class="post-card__date" datetime={post.publishedAt}>
					<Icon name="calendar" size={13} />
					<span>{formatDate(post.publishedAt, locale)}</span>
				</time>
			)
		}
	</footer>
</article>

<style>
	.post-card {
		padding: 1.35rem 1.5rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background-color: var(--color-surface);
		transition: border-color var(--transition-fast), background-color var(--transition-fast);
	}

	.post-card:hover {
		border-color: color-mix(in oklab, var(--color-border) 55%, var(--color-text-secondary));
	}

	.post-card__top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-sm);
		min-height: 1.25rem;
	}

	.post-card__company {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		min-width: 0;
		color: var(--color-text-secondary);
		font-size: var(--text-sm);
		text-decoration: none;
	}

	.post-card__company:hover {
		color: var(--color-text-primary);
		text-decoration: none;
	}

	.post-card__external {
		position: relative;
		display: inline-flex;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		width: 1.75rem;
		height: 1.75rem;
		border-radius: var(--radius-sm);
		color: var(--color-text-secondary);
	}

	.post-card__external::after {
		content: "";
		position: absolute;
		inset: -0.5rem;
	}

	.post-card__external:hover {
		background-color: var(--color-surface-muted);
		color: var(--color-accent);
		text-decoration: none;
	}

	.post-card__title {
		margin: 0.8rem 0 0.45rem;
		font-size: var(--text-base);
		font-weight: var(--weight-semibold);
		line-height: 1.4;
		letter-spacing: 0;
	}

	.post-card__title a {
		color: var(--color-text-primary);
		text-decoration: none;
	}

	.post-card__title a:hover {
		color: var(--color-accent);
		text-decoration: none;
	}

	.post-card__summary {
		margin: 0;
		color: var(--color-text-secondary);
		font-size: var(--text-sm);
		line-height: 1.6;
		text-wrap: pretty;
	}

	.post-card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin: 0.85rem 0 0;
		padding: 0;
		list-style: none;
	}

	.post-card__tags a {
		display: inline-flex;
		align-items: center;
		min-height: 1.55rem;
		padding: 0.15rem 0.5rem;
		border-radius: var(--radius-sm);
		background-color: var(--color-surface-muted);
		color: var(--color-text-primary);
		font-size: var(--text-xs);
		text-decoration: none;
	}

	.post-card__tags a:hover {
		color: var(--color-accent);
		text-decoration: none;
	}

	.post-card__footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-md);
		margin-block-start: 0.95rem;
		color: var(--color-text-secondary);
		font-size: var(--text-xs);
	}

	.post-card__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.8rem;
		min-width: 0;
	}

	.post-card__author {
		overflow: hidden;
		max-width: 18rem;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.post-card__meta-item,
	.post-card__date {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		white-space: nowrap;
	}

	.post-card__date {
		flex-shrink: 0;
		font-variant-numeric: tabular-nums;
	}

	@media (max-width: 767px) {
		.post-card {
			padding: 1.1rem 1rem;
		}

		.post-card__footer {
			align-items: flex-start;
			gap: var(--space-sm);
		}

		.post-card__meta {
			gap: 0.55rem;
		}

		.post-card__author {
			max-width: 12rem;
		}
	}
</style>
