---
import type { PostCard as PostCardData } from "../lib/db/queries";
import type { Locale } from "../lib/i18n/config";
import EmptyState from "./EmptyState.astro";
import FilterBar from "./FilterBar.astro";
import Pagination from "./Pagination.astro";
import PostCard from "./PostCard.astro";

interface Props {
	locale: Locale;
	posts: PostCardData[];
	heading: string;
	emptyTitle: string;
	emptyBody: string;
	filterHref?: string;
	filterActive?: boolean;
	filterClearHref?: string;
	page?: number;
	totalPages?: number;
	prevHref?: string;
	nextHref?: string;
}

const {
	locale,
	posts,
	heading,
	emptyTitle,
	emptyBody,
	filterHref,
	filterActive = false,
	filterClearHref,
	page = 1,
	totalPages = 1,
	prevHref,
	nextHref,
} = Astro.props;
---

<section class="post-list">
	<div class="post-list__head">
		<h2>{heading}</h2>
		{
			filterHref && (
				<FilterBar
					locale={locale}
					href={filterHref}
					active={filterActive}
					clearHref={filterClearHref}
				/>
			)
		}
	</div>

	{
		posts.length === 0 ? (
			<EmptyState title={emptyTitle} body={emptyBody} />
		) : (
			<div class="post-list__items">
				{posts.map((post) => <PostCard post={post} locale={locale} />)}
			</div>
		)
	}

	<Pagination
		locale={locale}
		page={page}
		totalPages={totalPages}
		prevHref={prevHref}
		nextHref={nextHref}
	/>
</section>

<style>
	.post-list__head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-sm);
		margin-block-end: 1rem;
	}

	.post-list__head h2 {
		margin: 0;
		font-size: var(--text-2xl);
		font-weight: var(--weight-semibold);
	}

	.post-list__items {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	@media (max-width: 767px) {
		.post-list__head {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.5rem;
		}

		.post-list__head h2 {
			font-size: var(--text-xl);
		}
	}
</style>
