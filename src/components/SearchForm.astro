---
import { localizePath, useTranslations } from "../lib/i18n";
import type { Locale } from "../lib/i18n/config";
import Icon from "./Icon.astro";

interface Props {
	locale: Locale;
	value?: string;
	/** 搜索时保留的筛选参数 */
	hidden?: Record<string, string>;
	/** 有值时显示清除按钮 */
	clearHref?: string;
}

const { locale, value = "", hidden = {}, clearHref } = Astro.props;
const t = useTranslations(locale);
const action = localizePath("/search", locale);
const id = "search-input";
---

<form class="search" action={action} method="get" role="search">
	<label class="visually-hidden" for={id}>{t("search.placeholder")}</label>
	<span class="search__icon" aria-hidden="true"><Icon name="search" size={15} /></span>
	<input
		id={id}
		class="search__input"
		type="search"
		name="q"
		value={value || undefined}
		placeholder={t("search.placeholder")}
		autocomplete="off"
		spellcheck="false"
	/>
	{
		Object.entries(hidden).map(([name, hiddenValue]) => (
			<input type="hidden" name={name} value={hiddenValue} />
		))
	}
	{
		value && clearHref && (
			<a class="search__clear" href={clearHref} aria-label={t("search.clear")}>
				<Icon name="close" size={14} />
			</a>
		)
	}
</form>

<style>
	.search {
		position: relative;
		display: flex;
		align-items: center;
		width: min(20rem, 100%);
	}

	.search__icon {
		position: absolute;
		inset-inline-start: 0.7rem;
		display: flex;
		color: var(--color-text-secondary);
		pointer-events: none;
	}

	.search__input {
		width: 100%;
		min-height: 2.15rem;
		padding: 0.35rem 2.2rem 0.35rem 2.15rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background-color: var(--color-surface);
		color: var(--color-text-primary);
		font-size: var(--text-sm);
		line-height: 1.4;
		appearance: none;
		transition: border-color var(--transition-fast), background-color var(--transition-fast);
	}

	.search__input::placeholder {
		color: var(--color-text-secondary);
	}

	.search__input:hover {
		border-color: color-mix(in oklab, var(--color-border) 70%, var(--color-text-secondary));
	}

	.search__input:focus-visible {
		border-color: var(--color-accent);
		outline: var(--focus-ring-width) solid var(--color-accent);
		outline-offset: var(--focus-ring-offset);
	}

	.search__input::-webkit-search-cancel-button {
		display: none;
	}

	.search__clear {
		position: absolute;
		inset-inline-end: 0.4rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.6rem;
		height: 1.6rem;
		border-radius: var(--radius-sm);
		color: var(--color-text-secondary);
	}

	/* 视觉保持小巧，指针目标扩到 40px */
	.search__clear::after {
		content: "";
		position: absolute;
		inset: -0.45rem;
	}

	.search__clear:hover {
		background-color: var(--color-surface-muted);
		color: var(--color-text-primary);
		text-decoration: none;
	}

	@media (max-width: 767px) {
		.search {
			width: 100%;
		}

		.search__input {
			/* iOS 在小于 16px 时会放大整页 */
			font-size: var(--text-base);
		}
	}
</style>
