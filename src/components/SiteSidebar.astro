---
import type { CompanyCard, TagCard } from "../lib/db/queries";
import { localizePath, useTranslations } from "../lib/i18n";
import { companyDisplayName } from "../lib/i18n/company";
import type { Locale } from "../lib/i18n/config";
import { site } from "../lib/site";
import CompanyLogo from "./CompanyLogo.astro";
import Icon from "./Icon.astro";
import LanguageSwitch from "./LanguageSwitch.astro";
import SiteLogo from "./SiteLogo.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
	locale: Locale;
	pathname: string;
	tags: TagCard[];
	companies: CompanyCard[];
}

const { locale, pathname, tags, companies, stats } = Astro.props;
const t = useTranslations(locale);
const homeHref = localizePath("/", locale);
const topTags = tags.slice(0, 6);
const topCompanies = companies.slice(0, 7);

function isCurrent(href: string): boolean {
	const path = pathname.replace(/\/$/, "") || "/";
	return path === href.replace(/\/$/, "");
}
---

<aside class="sidebar">
	<div class="sidebar__brand">
		<SiteLogo locale={locale} href={homeHref} />
		<div class="sidebar__actions">
			<ThemeToggle locale={locale} />
			<label class="sidebar__close" for="nav-toggle">
				<Icon name="close" size={16} />
				<span class="visually-hidden">{t("nav.close")}</span>
			</label>
		</div>
	</div>

	<nav class="sidebar__nav" aria-label={t("nav.primary")}>
		<section class="sidebar__section">
			<h2 class="sidebar__label">
				<Icon name="hash" size={13} />
				<span>{t("nav.tags")}</span>
			</h2>
			<ul class="sidebar__list">
				{
					topTags.map((tag) => {
						const href = localizePath(`/tag/${tag.slug}`, locale);
						return (
							<li>
								<a class="sidebar__item" href={href} aria-current={isCurrent(href) ? "page" : undefined}>
									<span class="sidebar__item-name">{tag.name}</span>
									<span class="sidebar__count">{tag.count}</span>
								</a>
							</li>
						);
					})
				}
			</ul>
			<a class="sidebar__view-all" href={localizePath("/tags", locale)}>{t("nav.viewAllTags")}</a>
		</section>

		<section class="sidebar__section sidebar__section--companies">
			<h2 class="sidebar__label">
				<Icon name="building" size={13} />
				<span>{t("nav.companies")}</span>
			</h2>
			<ul class="sidebar__list">
				{
					topCompanies.map((company) => {
						const href = localizePath(`/company/${company.slug}`, locale);
						const name = companyDisplayName(company, locale);
						return (
							<li>
								<a class="sidebar__item" href={href} aria-current={isCurrent(href) ? "page" : undefined}>
									<span class="sidebar__company">
										<CompanyLogo company={company} size="sm" label={name} />
										<span class="sidebar__item-name" lang={locale === "en" && company.nameEn ? "en" : undefined}>{name}</span>
									</span>
									<span class="sidebar__count">{company.count}</span>
								</a>
							</li>
						);
					})
				}
			</ul>
			<a class="sidebar__view-all" href={localizePath("/companies", locale)}>{t("nav.viewAllCompanies")}</a>
		</section>

		<section class="digest">
			<div class="digest__heading">
				<Icon name="mail" size={14} />
				<span>{t("nav.digestTitle")}</span>
			</div>
			<p class="digest__body">{t("nav.digestBody")}</p>
			<a class="digest__action" href={localizePath("/rss.xml", locale)}>
				<Icon name="rss" size={13} />
				<span>{t("nav.digestAction")}</span>
			</a>
		</section>

	</nav>

	<footer class="sidebar__footer">
		<div class="sidebar__links">
			<a href={localizePath("/about", locale)}>{t("nav.about")}</a>
			<span aria-hidden="true">·</span>
			<a href={site.repo} target="_blank" rel="noopener noreferrer">{t("nav.repo")}</a>
		</div>
		<LanguageSwitch locale={locale} />
	</footer>
</aside>

<style>
	.sidebar {
		display: flex;
		flex-direction: column;
		width: 100%;
		height: 100dvh;
		padding: 0 0.75rem 0.75rem;
		background-color: var(--color-surface);
		border-inline-end: 1px solid var(--color-border);
		overflow: hidden;
	}

	.sidebar__brand {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-sm);
		padding: 1.125rem 0.5rem 1.125rem;
		border-block-end: 1px solid var(--color-border);
	}

	.sidebar__nav {
		flex: 1;
		min-height: 0;
		overflow-y: auto;
		padding-block: 0.75rem 0.5rem;
		scrollbar-width: thin;
	}

	.sidebar__section {
		margin-block-end: 0.75rem;
	}

	.sidebar__label {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		margin: 0;
		padding: 0.35rem 0.5rem 0.45rem;
		color: var(--color-text-secondary);
		font-size: var(--text-xs);
		font-weight: var(--weight-medium);
		letter-spacing: 0.02em;
	}

	.sidebar__list {
		display: flex;
		flex-direction: column;
		gap: 1px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.sidebar__item {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-sm);
		min-height: 2rem;
		padding: 0.3rem 0.5rem;
		border-radius: var(--radius-sm);
		color: var(--color-text-primary);
		font-size: var(--text-sm);
		text-decoration: none;
		transition: background-color var(--transition-fast), color var(--transition-fast);
	}

	.sidebar__item:hover {
		background-color: var(--color-surface-muted);
		color: var(--color-text-primary);
		text-decoration: none;
	}

	.sidebar__item[aria-current="page"] {
		background-color: var(--color-surface-muted);
		font-weight: var(--weight-medium);
	}

	.sidebar__item-name {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.sidebar__count {
		flex-shrink: 0;
		color: var(--color-text-secondary);
		font-size: var(--text-xs);
		font-variant-numeric: tabular-nums;
	}

	.sidebar__company {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		min-width: 0;
	}

	.sidebar__section--companies .sidebar__item-name {
		min-width: 0;
	}

	.sidebar__view-all {
		display: block;
		padding: 0.3rem 0.5rem;
		color: var(--color-text-secondary);
		font-size: var(--text-xs);
		text-align: center;
		text-decoration: none;
	}

	.sidebar__view-all:hover {
		color: var(--color-accent);
		text-decoration: none;
	}

	.digest {
		margin: 0.5rem 0.5rem 0;
		padding: 0.75rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
	}

	.digest__heading {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		margin-block-end: 0.25rem;
		font-size: var(--text-xs);
		font-weight: var(--weight-medium);
	}

	.digest__body {
		margin: 0 0 0.6rem;
		color: var(--color-text-secondary);
		font-size: var(--text-xs);
		line-height: 1.5;
	}

	.digest__action {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		width: 100%;
		min-height: 1.9rem;
		padding: 0.3rem 0.5rem;
		border-radius: var(--radius-sm);
		background-color: var(--color-accent-strong);
		color: var(--color-on-accent);
		font-size: var(--text-xs);
		font-weight: var(--weight-medium);
		text-decoration: none;
	}

	.digest__action:hover {
		background-color: var(--color-accent-strong);
		color: var(--color-on-accent);
		filter: brightness(1.08);
		text-decoration: none;
	}

	.sidebar__actions {
		display: flex;
		align-items: center;
		gap: 0.15rem;
	}

	.sidebar__close {
		display: none;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		padding: 0;
		border: 0;
		border-radius: var(--radius-sm);
		background: transparent;
		color: var(--color-text-secondary);
		cursor: pointer;
	}

	.sidebar__close:hover {
		background-color: var(--color-surface-muted);
		color: var(--color-text-primary);
	}

	@media (max-width: 767px) {
		.sidebar__close {
			display: inline-flex;
			width: 2.75rem;
			height: 2.75rem;
		}

		.sidebar__item {
			min-height: 2.5rem;
		}

		.sidebar__view-all {
			display: flex;
			align-items: center;
			justify-content: center;
			min-height: 2.5rem;
		}

		.digest__action {
			min-height: 2.75rem;
		}
	}

	.sidebar__footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-sm);
		padding: 0.75rem 0.5rem 0;
		border-block-start: 1px solid var(--color-border);
		color: var(--color-text-secondary);
		font-size: var(--text-xs);
	}

	.sidebar__links {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.sidebar__links a {
		color: var(--color-text-secondary);
		text-decoration: none;
	}

	.sidebar__links a:hover {
		color: var(--color-text-primary);
		text-decoration: none;
	}

	@media (max-width: 767px) {
		.sidebar {
			border-inline-end: 0;
			box-shadow: 0 20px 50px color-mix(in oklab, var(--color-text-primary) 18%, transparent);
		}
	}
</style>
