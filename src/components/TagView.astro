---
import type { CompanyCard, PostCard as PostCardData, TagCard } from "../lib/db/queries";
import { formatCount, formatList, localizePath, useTranslations } from "../lib/i18n";
import { companyDisplayName } from "../lib/i18n/company";
import type { Locale } from "../lib/i18n/config";
import { searchHref } from "../lib/search-url";
import Breadcrumb from "./Breadcrumb.astro";
import CompanyLogo from "./CompanyLogo.astro";
import Icon from "./Icon.astro";
import PageHeader from "./PageHeader.astro";
import PostList from "./PostList.astro";

interface Props {
	locale: Locale;
	tag: TagCard;
	companies: CompanyCard[];
	posts: PostCardData[];
	page: number;
	totalPages: number;
	prevHref?: string;
	nextHref?: string;
}

const { locale, tag, companies, posts, page, totalPages, prevHref, nextHref } = Astro.props;
const t = useTranslations(locale);

const count = formatCount(locale, "articles", tag.count);
const companyNames = formatList(
	locale,
	companies.slice(0, 3).map((company) => company.name),
);
const description = companyNames
	? t("tag.description", { count, companies: companyNames })
	: t("tag.descriptionPlain", { count });
const homeHref = localizePath("/", locale);
---

<PageHeader
	locale={locale}
	icon="hash"
	title={t("tag.heading", { name: tag.name })}
	description={description}
/>

<div class="tag-breadcrumb">
	<Breadcrumb
		locale={locale}
		items={[
			{ label: t("breadcrumb.home"), href: homeHref },
			{ label: tag.name },
		]}
	/>
</div>

{
	companies.length > 0 && (
		<section class="tag-companies">
			<h2>
				<Icon name="building" size={16} />
				<span>{t("tag.companies")}</span>
			</h2>
			<ul>
				{companies.map((company) => {
					const name = companyDisplayName(company, locale);
					return (
						<li>
							<a href={localizePath(`/company/${company.slug}`, locale)}>
								<CompanyLogo company={company} size="sm" label={name} />
								<span lang={locale === "en" && company.nameEn ? "en" : undefined}>{name}</span>
								<span class="tag-companies__count">({company.count})</span>
							</a>
						</li>
					);
				})}
			</ul>
		</section>
	)
}

<PostList
	locale={locale}
	posts={posts}
	heading={t("tag.latest", { name: tag.name })}
	emptyTitle={t("list.empty")}
	emptyBody={t("search.noQuery.body")}
	filterHref={searchHref(locale, { tag: tag.slug, has_code: true })}
	page={page}
	totalPages={totalPages}
	prevHref={prevHref}
	nextHref={nextHref}
/>

<style>
	.tag-breadcrumb {
		margin-block: 0.9rem 1.5rem;
	}

	.tag-companies {
		margin-block-end: 2rem;
		padding: 1.1rem 1.25rem 1.25rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background-color: var(--color-surface);
	}

	.tag-companies h2 {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin-block-end: 0.9rem;
		font-size: var(--text-base);
		font-weight: var(--weight-semibold);
	}

	.tag-companies ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tag-companies a {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		min-height: 1.9rem;
		padding: 0.25rem 0.65rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		color: var(--color-text-primary);
		font-size: var(--text-xs);
		text-decoration: none;
		transition: background-color var(--transition-fast), border-color var(--transition-fast);
	}

	.tag-companies a:hover {
		border-color: color-mix(in oklab, var(--color-border) 55%, var(--color-text-secondary));
		background-color: var(--color-surface-muted);
		text-decoration: none;
	}

	.tag-companies__count {
		color: var(--color-text-secondary);
		font-variant-numeric: tabular-nums;
	}
</style>
