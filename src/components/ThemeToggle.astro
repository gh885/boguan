---
import { useTranslations } from "../lib/i18n";
import type { Locale } from "../lib/i18n/config";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

{/*
	无 JS 时按钮隐藏（见 .theme-toggle 的 display），主题跟随系统即可。
	aria-label 描述的是「点下去会发生什么」，由组件脚本按当前主题换文案。
*/}
<button
	class="theme-toggle"
	type="button"
	aria-label={t("theme.switchToDark")}
	data-label-light={t("theme.switchToLight")}
	data-label-dark={t("theme.switchToDark")}
>
	<svg class="icon icon-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
		<path
			d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"
			fill="none"
			stroke="currentColor"
			stroke-width="1.6"
			stroke-linejoin="round"
		/>
	</svg>
	<svg class="icon icon-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
		<circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.6" />
		<path
			d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8"
			fill="none"
			stroke="currentColor"
			stroke-width="1.6"
			stroke-linecap="round"
		/>
	</svg>
</button>

<script>
	const root = document.documentElement;
	const button = document.querySelector<HTMLButtonElement>(".theme-toggle");
	const media = window.matchMedia("(prefers-color-scheme: dark)");
	const STORAGE_KEY = "boguan:theme";

	const systemTheme = (): "light" | "dark" => (media.matches ? "dark" : "light");
	const currentTheme = (): "light" | "dark" =>
		root.dataset.theme === "light" || root.dataset.theme === "dark" ? root.dataset.theme : systemTheme();

	function sync(): void {
		if (!button) return;
		// 现在的主题为深色时，点击会切到浅色，所以标签是「切换到浅色模式」
		const label = currentTheme() === "dark" ? button.dataset.labelLight : button.dataset.labelDark;
		button.setAttribute("aria-label", label ?? "");
	}

	button?.addEventListener("click", () => {
		const next = currentTheme() === "dark" ? "light" : "dark";
		if (next === systemTheme()) {
			// 与系统偏好一致时不留覆盖，回到「跟随系统」
			delete root.dataset.theme;
			try {
				localStorage.removeItem(STORAGE_KEY);
			} catch {
				// 隐私模式下不可用，忽略
			}
		} else {
			root.dataset.theme = next;
			try {
				localStorage.setItem(STORAGE_KEY, next);
			} catch {
				// 同上
			}
		}
		sync();
	});

	media.addEventListener("change", sync);
	sync();
</script>

<style>
	.theme-toggle {
		display: none; /* 无 JS 时没有意义，脚本跑起来后由 [data-js="true"] 打开 */
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		padding: 0;
		border: 0;
		border-radius: var(--radius-sm);
		background-color: transparent;
		color: var(--color-text-secondary);
		cursor: pointer;
		transition: background-color var(--transition-fast), color var(--transition-fast);
	}

	:global([data-js="true"]) .theme-toggle {
		display: inline-flex;
	}

	.theme-toggle:hover {
		background-color: var(--color-surface-muted);
		color: var(--color-text-primary);
	}

	.icon {
		width: 1rem;
		height: 1rem;
	}

	/* 图标跟随与令牌同一套判定：属性优先，否则看系统 */
	.icon-sun {
		display: none;
	}

	@media (prefers-color-scheme: dark) {
		.icon-moon {
			display: none;
		}

		.icon-sun {
			display: block;
		}
	}

	:global([data-theme="light"]) .icon-moon {
		display: block;
	}

	:global([data-theme="light"]) .icon-sun {
		display: none;
	}

	:global([data-theme="dark"]) .icon-moon {
		display: none;
	}

	:global([data-theme="dark"]) .icon-sun {
		display: block;
	}

	@media (max-width: 767px) {
		.theme-toggle {
			width: 2.75rem;
			height: 2.75rem;
		}
	}
</style>
