---
import LanguageSwitch from "../components/LanguageSwitch.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { alternateLinks, localizePath, resolveLocale, useTranslations } from "../lib/i18n";
import { defaultLocale, locales, ogLocales, type Locale } from "../lib/i18n/config";
import { site } from "../lib/site";
import "../styles/tokens.css";
import "../styles/base.css";

interface Props {
	/** 页面自己的标题，不含站名；`<title>` 由 layout 统一拼上站名。 */
	title: string;
	description: string;
	/** 搜索页、筛选组合页等薄页面传 true。 */
	noindex?: boolean;
	/** 默认从 `Astro.currentLocale` 推导，一般不用传。 */
	locale?: Locale;
	/**
	 * 本页实际生成的语言，默认全部。页面只在部分语言下存在时（例如某个只有中文的专题），
	 * 在这里收窄，否则 hreflang 与语言切换都会指向 404。
	 */
	alternateLocales?: readonly Locale[];
}

const {
	title,
	description,
	noindex = false,
	locale = resolveLocale(Astro.currentLocale),
	alternateLocales = locales,
} = Astro.props;

const t = useTranslations(locale);
const pageTitle = `${title} · ${site.name}`;
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, site.url).href;
const alternates = alternateLinks(pathname, alternateLocales);
const xDefault = alternates.find((alternate) => alternate.locale === defaultLocale);
const robots = noindex ? "noindex, follow" : "index, follow";
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		{/*
			主题在首屏绘制前定好，避免白闪；只读本地偏好，不改任何页面状态。
			见 docs/ARCHITECTURE.md §10。
		*/}
		<script is:inline>
			(() => {
				const root = document.documentElement;
				root.dataset.js = "true";
				try {
					const stored = localStorage.getItem("boguan:theme");
					if (stored === "light" || stored === "dark") root.dataset.theme = stored;
				} catch {
					// 隐私模式下 localStorage 不可用，跟随系统即可
				}
			})();
		</script>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light dark" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{
			alternates.map((alternate) => (
				<link
					rel="alternate"
					hreflang={alternate.hreflang}
					href={new URL(alternate.href, site.url).href}
				/>
			))
		}
		{xDefault && (
			<link rel="alternate" hreflang="x-default" href={new URL(xDefault.href, site.url).href} />
		)}
		<link
			rel="alternate"
			type="application/rss+xml"
			title={t("feed.title")}
			href={new URL(localizePath("/rss.xml", locale), site.url).href}
		/>
		<meta name="robots" content={robots} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={ogLocales[locale]} />
		{
			alternates
				.filter((alternate) => alternate.locale !== locale)
				.map((alternate) => (
					<meta property="og:locale:alternate" content={ogLocales[alternate.locale]} />
				))
		}
		<meta name="twitter:card" content="summary" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
	</head>

	<body>
		<a class="skip-link" href="#main">{t("nav.skipToContent")}</a>

		<header class="site-header">
			<div class="page site-header__inner">
				<a class="site-brand" href={localizePath("/", locale)}>{site.name}</a>
				<div class="site-actions">
					<LanguageSwitch locale={locale} />
					<ThemeToggle locale={locale} />
				</div>
			</div>
		</header>

		<main id="main" class="page">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="page">
				<p>{t("footer.note")}</p>
			</div>
		</footer>
	</body>
</html>

<style>
	.site-header {
		border-block-end: 1px solid var(--color-border);
		background-color: var(--color-surface);
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-md);
		min-height: 3.5rem;
	}

	.site-brand {
		color: var(--color-text-primary);
		font-size: var(--text-lg);
		font-weight: var(--weight-semibold);
		text-decoration: none;
		letter-spacing: 0.02em;
	}

	.site-brand:hover {
		color: var(--color-accent);
	}

	.site-actions {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
	}

	.site-footer {
		border-block-start: 1px solid var(--color-border);
		padding-block: var(--space-lg);
		color: var(--color-text-secondary);
		font-size: var(--text-xs);
	}

	.site-footer p {
		margin: 0;
		max-width: var(--width-measure);
	}
</style>
