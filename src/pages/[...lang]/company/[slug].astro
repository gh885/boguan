---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CompanyView from "../../../components/CompanyView.astro";
import {
	companyCards,
	companyTopTags,
	openWebDatabase,
	postYearsByFilters,
	postsByCompany,
	type CompanyCard,
} from "../../../lib/db/queries";
import { localizePath, localeRoutes, useTranslations } from "../../../lib/i18n";
import { companyDisplayName } from "../../../lib/i18n/company";
import type { Locale } from "../../../lib/i18n/config";
import { INDEX_PAGE_SIZE, pageCount, pagePath } from "../../../lib/pagination";
import { collectionJsonLd } from "../../../lib/structured-data";
import { site } from "../../../lib/site";

interface Props {
	locale: Locale;
	/** getStaticPaths 已经查过全量 companyCards,这里拿现成的,不再重跑 left join 聚合 */
	company: CompanyCard;
}

export const getStaticPaths = (() => {
	const companies = companyCards(openWebDatabase());
	return companies.flatMap((company) =>
		localeRoutes({ slug: company.slug }).map((route) => ({
			...route,
			props: { ...route.props, company },
		})),
	);
}) satisfies GetStaticPaths;

const { locale, company } = Astro.props;
const t = useTranslations(locale);
const db = openWebDatabase();
const slug = String(Astro.params.slug);

const topTags = companyTopTags(db, slug, 8);
const years = postYearsByFilters(db, { companySlug: slug });
const { items, total } = postsByCompany(db, slug, { limit: INDEX_PAGE_SIZE });
const totalPages = pageCount(total, INDEX_PAGE_SIZE);
const navYearsHref = years[0]
	? localizePath(`/year/${years[0].year}`, locale)
	: localizePath("/tags", locale);
const name = companyDisplayName(company, locale);
const title = t("meta.company.title", { name });
const description = t("meta.company.description", { name });
---

<BaseLayout
	locale={locale}
	title={title}
	description={description}
	chrome="bare"
	nextHref={totalPages > 1 ? localizePath(pagePath(`/company/${slug}`, 2), locale) : undefined}
	jsonLd={collectionJsonLd({
		name: title,
		description,
		url: new URL(localizePath(`/company/${slug}`, locale), site.url).href,
		items,
	})}
>
	<CompanyView
		locale={locale}
		company={company}
		topTags={topTags}
		years={years}
		posts={items}
		total={total}
		page={1}
		totalPages={totalPages}
		nextHref={totalPages > 1 ? localizePath(pagePath(`/company/${slug}`, 2), locale) : undefined}
		navYearsHref={navYearsHref}
	/>
</BaseLayout>
