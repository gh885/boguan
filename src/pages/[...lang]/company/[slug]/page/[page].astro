---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import CompanyView from "../../../../../components/CompanyView.astro";
import {
	companyBySlug,
	companyCards,
	companyTopTags,
	openWebDatabase,
	postYearsByFilters,
	postsByCompany,
} from "../../../../../lib/db/queries";
import { localizePath, localeRoutes, useTranslations } from "../../../../../lib/i18n";
import { companyDisplayName } from "../../../../../lib/i18n/company";
import type { Locale } from "../../../../../lib/i18n/config";
import {
	INDEX_PAGE_SIZE,
	pageCount,
	pageOffset,
	pagePath,
} from "../../../../../lib/pagination";
import { collectionJsonLd } from "../../../../../lib/structured-data";
import { site } from "../../../../../lib/site";

interface Props {
	locale: Locale;
}

export const getStaticPaths = (() => {
	const db = openWebDatabase();
	const companies = companyCards(db);
	return companies.flatMap((company) => {
		const pages = pageCount(company.count, INDEX_PAGE_SIZE);
		return Array.from({ length: Math.max(0, pages - 1) }, (_, index) => index + 2).flatMap((page) =>
			localeRoutes({ slug: company.slug, page: String(page) }),
		);
	});
}) satisfies GetStaticPaths;

const { locale } = Astro.props;
const t = useTranslations(locale);
const db = openWebDatabase();
const slug = String(Astro.params.slug);
const page = Math.max(2, Number(Astro.params.page));
const company = companyBySlug(db, slug);

if (!company) throw new Error(`公司不存在：${slug}`);

const topTags = companyTopTags(db, slug, 8);
const years = postYearsByFilters(db, { companySlug: slug });
const { items, total } = postsByCompany(db, slug, {
	limit: INDEX_PAGE_SIZE,
	offset: pageOffset(page, INDEX_PAGE_SIZE),
});
const totalPages = pageCount(total, INDEX_PAGE_SIZE);
const navYearsHref = years[0]
	? localizePath(`/year/${years[0].year}`, locale)
	: localizePath("/tags", locale);
const name = companyDisplayName(company, locale);
const title = `${t("meta.company.title", { name })}${t("meta.page.suffix", { page })}`;
const description = `${t("meta.company.description", { name })}${t("meta.page.suffix", { page })}`;

const prevHref = localizePath(pagePath(`/company/${slug}`, page - 1), locale);
const nextHref =
	page < totalPages ? localizePath(pagePath(`/company/${slug}`, page + 1), locale) : undefined;
---

<BaseLayout
	locale={locale}
	title={title}
	description={description}
	chrome="bare"
	prevHref={prevHref}
	nextHref={nextHref}
	jsonLd={collectionJsonLd({
		name: title,
		description,
		url: new URL(localizePath(pagePath(`/company/${slug}`, page), locale), site.url).href,
		items,
	})}
>
	<CompanyView
		locale={locale}
		company={company}
		topTags={topTags}
		years={years}
		posts={items}
		total={total}
		page={page}
		totalPages={totalPages}
		prevHref={prevHref}
		nextHref={nextHref}
		navYearsHref={navYearsHref}
	/>
</BaseLayout>
