---
import { editionDay, editionNumberAt, editionRange } from "@boguan/domain";
import type { GetStaticPaths } from "astro";
import IndexSheet from "../../../../../components/IndexSheet.astro";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import {
	countPosts,
	editionSummaries,
	openWebDatabase,
	postsByEdition,
	postYears,
} from "../../../../../lib/db/queries";
import {
	formatDate,
	formatLongDate,
	formatNumber,
	localizePath,
	localeRoutes,
	useTranslations,
} from "../../../../../lib/i18n";
import type { Locale } from "../../../../../lib/i18n/config";
import type { IndexRailModule } from "../../../../../lib/index-sheet";
import { INDEX_PAGE_SIZE, pageCount, pageOffset, pagePath } from "../../../../../lib/pagination";
import { collectionJsonLd } from "../../../../../lib/structured-data";
import { site } from "../../../../../lib/site";

/**
 * 期页的续版：一期刊得多（例如创刊号一次入版几百篇）才需要翻页。
 * 与首页续版同构：第 1 页不带 `/page/1`，避免同一内容两个 URL。
 */

export const getStaticPaths = (() => {
	const latest = Math.max(1, editionNumberAt(new Date()) ?? 1);
	const summaries = new Map(editionSummaries(openWebDatabase()).map((row) => [row.number, row.count]));
	const routes = [];
	for (let number = 1; number <= latest; number += 1) {
		const pages = pageCount(summaries.get(number) ?? 0, INDEX_PAGE_SIZE);
		for (let page = 2; page <= pages; page += 1) {
			routes.push(...localeRoutes({ n: String(number), page: String(page) }));
		}
	}
	return routes;
}) satisfies GetStaticPaths;

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const db = openWebDatabase();

const number = Number(Astro.params.n);
const page = Math.max(2, Number(Astro.params.page));
const day = editionDay(number);
const range = editionRange(number);

if (day === null || range === null) throw new Error(`期号不存在：${String(Astro.params.n)}`);

const today = editionNumberAt(new Date()) ?? number;
const summaries = editionSummaries(db);
const countOf = (value: number) => summaries.find((row) => row.number === value)?.count ?? 0;

const { items, total } = postsByEdition(db, range, {
	limit: INDEX_PAGE_SIZE,
	offset: pageOffset(page, INDEX_PAGE_SIZE),
});
const cumulative = countPosts(db, { firstSeenTo: range.endIso });
const totalPages = pageCount(total, INDEX_PAGE_SIZE);
const years = postYears(db);
const navYearsHref = years[0]
	? localizePath(`/year/${years[0].year}`, locale)
	: localizePath("/tags", locale);

const isoLongDate = formatLongDate(day, locale);
const shortDate = formatDate(day, locale);
const dateNumber = formatNumber(locale, number);
const title = `${t("meta.edition.title", { number: dateNumber, date: shortDate })}${t("meta.page.suffix", { page })}`;
const description =
	total > 0
		? `${t("meta.edition.description", {
				number: dateNumber,
				date: shortDate,
				count: formatNumber(locale, total),
			})}${t("meta.page.suffix", { page })}`
		: `${t("meta.edition.descriptionEmpty", { number: dateNumber, date: shortDate })}${t("meta.page.suffix", { page })}`;

const prevHref = localizePath(pagePath(`/edition/${number}`, page - 1), locale);
const nextHref =
	page < totalPages ? localizePath(pagePath(`/edition/${number}`, page + 1), locale) : undefined;

const rail: IndexRailModule[] = [
	{
		title: t("edition.rail"),
		links: [
			...(number > 1
				? [
						{
							label: t("edition.previous"),
							href: localizePath(`/edition/${number - 1}`, locale),
							count: countOf(number - 1) || undefined,
						},
					]
				: []),
			...(number < today
				? [
						{
							label: t("edition.next"),
							href: localizePath(`/edition/${number + 1}`, locale),
							count: countOf(number + 1) || undefined,
						},
					]
				: []),
		],
		allHref: localizePath("/editions", locale),
		allLabel: t("edition.all"),
	},
];
---

<BaseLayout
	locale={locale}
	title={title}
	description={description}
	chrome="bare"
	prevHref={prevHref}
	nextHref={nextHref}
	jsonLd={collectionJsonLd({
		name: title,
		description,
		url: new URL(localizePath(pagePath(`/edition/${number}`, page), locale), site.url).href,
		items,
	})}
>
	<IndexSheet
		locale={locale}
		current="editions"
		kicker={t("edition.kicker.issue", { number: dateNumber })}
		title={isoLongDate}
		facts={[
			t("edition.facts.new", { count: formatNumber(locale, total) }),
			t("edition.facts.cumulative", { count: formatNumber(locale, cumulative) }),
		]}
		posts={items}
		total={total}
		page={page}
		totalPages={totalPages}
		pageSize={INDEX_PAGE_SIZE}
		prevHref={prevHref}
		nextHref={nextHref}
		rail={rail}
		footerNote={t("edition.issue", { number: dateNumber })}
		navYearsHref={navYearsHref}
	/>
</BaseLayout>