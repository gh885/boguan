---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { localeRoutes, useTranslations } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n/config";

// 一份页面 × 所有语言：/ 和 /en/
export const getStaticPaths = (() => localeRoutes()) satisfies GetStaticPaths;

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout
	locale={locale}
	title={t("meta.home.title")}
	description={t("meta.home.description")}
>
	<section class="hero">
		<h1>{t("meta.home.title")}</h1>
		<p class="lead">{t("home.intro")}</p>
	</section>

	<section class="status">
		<h2>{t("home.building.title")}</h2>
		<p>{t("home.building.body")}</p>
	</section>
</BaseLayout>

<style>
	.hero {
		max-width: var(--width-measure);
	}

	.hero h1 {
		margin-block-end: var(--space-md);
	}

	.lead {
		font-size: var(--text-lg);
		line-height: var(--leading-normal);
		color: var(--color-text-secondary);
	}

	.status {
		margin-block-start: var(--space-2xl);
		max-width: 40rem;
		padding: var(--space-lg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background-color: var(--color-surface);
	}

	.status h2 {
		font-size: var(--text-xl);
	}

	.status p {
		margin: 0;
		color: var(--color-text-secondary);
	}
</style>
