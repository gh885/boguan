---
import type { GetStaticPaths } from "astro";
import HomeNewspaper from "../../components/HomeNewspaper.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
	latestPosts,
	openWebDatabase,
	postYears,
	siteStats,
	tagIndex,
} from "../../lib/db/queries";
import { localizePath, localeRoutes, useTranslations } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n/config";
import { PAGE_SIZE, pageCount, pagePath } from "../../lib/pagination";
import { searchHref } from "../../lib/search-url";
import { homeJsonLd } from "../../lib/structured-data";
import { site } from "../../lib/site";
import { isIndexableTag } from "../../lib/tags";

// 一份页面 × 所有语言：/ 和 /en/
export const getStaticPaths = (() => localeRoutes()) satisfies GetStaticPaths;

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const db = openWebDatabase();
const stats = siteStats(db);
const { items, total } = latestPosts(db, { limit: PAGE_SIZE });
const [lead, ...latest] = items;
const topics = tagIndex(db)
	.filter((tag) => isIndexableTag(tag.count))
	.slice(0, 3);
const years = postYears(db);
const yearHref = years[0]
	? localizePath(`/year/${years[0].year}`, locale)
	: localizePath("/tags", locale);

const totalPages = pageCount(total);
const description = t("meta.home.description");
const nextHref = totalPages > 1 ? localizePath(pagePath("/", 2), locale) : undefined;
---

<BaseLayout
	locale={locale}
	title={t("meta.home.title")}
	description={description}
	chrome="bare"
	nextHref={nextHref}
	jsonLd={homeJsonLd(
		items,
		description,
		t("home.latestIndex"),
		new URL(searchHref(locale), site.url).href,
		locale,
	)}
>
	<HomeNewspaper
		locale={locale}
		items={latest}
		lead={lead}
		topics={topics}
		stats={stats}
		page={1}
		totalPages={totalPages}
		nextHref={nextHref}
		yearHref={yearHref}
	/>
</BaseLayout>
