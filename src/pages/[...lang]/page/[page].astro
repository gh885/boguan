---
import type { GetStaticPaths } from "astro";
import IndexSheet from "../../../components/IndexSheet.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
	companyCards,
	latestPosts,
	openWebDatabase,
	postYears,
	siteStats,
	topTags,
} from "../../../lib/db/queries";
import { companyDisplayName } from "../../../lib/i18n/company";
import { formatCount, localizePath, localeRoutes, useTranslations } from "../../../lib/i18n";
import type { Locale } from "../../../lib/i18n/config";
import type { IndexFacetGroup, IndexRailModule } from "../../../lib/index-sheet";
import { PAGE_SIZE, pageCount, pageOffset, pagePath } from "../../../lib/pagination";
import { searchHref } from "../../../lib/search-url";
import { collectionJsonLd } from "../../../lib/structured-data";
import { site } from "../../../lib/site";

interface Props {
	locale: Locale;
}

export const getStaticPaths = (() => {
	const total = latestPosts(openWebDatabase(), { limit: 1 }).total;
	const pages = pageCount(total);
	return Array.from({ length: Math.max(0, pages - 1) }, (_, index) => index + 2).flatMap(
		(page) => localeRoutes({ page: String(page) }),
	);
}) satisfies GetStaticPaths;

const { locale } = Astro.props;
const t = useTranslations(locale);
const page = Math.max(2, Number(Astro.params.page));

const db = openWebDatabase();
const stats = siteStats(db);
const { items, total } = latestPosts(db, { limit: PAGE_SIZE, offset: pageOffset(page) });
const totalPages = pageCount(total);
const years = postYears(db);
const hotTags = topTags(db, 8);
const companies = companyCards(db).slice(0, 6);
const navYearsHref = years[0]
	? localizePath(`/year/${years[0].year}`, locale)
	: localizePath("/tags", locale);

const facets: IndexFacetGroup[] = [
	{
		label: t("filter.label"),
		items: [
			{
				label: t("filter.hasCode"),
				href: searchHref(locale, { has_code: true }),
			},
		],
	},
];

if (years.length > 1) {
	facets.push({
		label: t("nav.years"),
		items: years.map((entry) => ({
			label: String(entry.year),
			count: entry.count,
			href: localizePath(`/year/${entry.year}`, locale),
		})),
	});
}

const rail: IndexRailModule[] = [
	{
		title: t("search.hotTags"),
		links: hotTags.map((tag) => ({
			label: tag.name,
			href: localizePath(`/tag/${tag.slug}`, locale),
			count: tag.count,
			lang: locale === "en" ? "zh-CN" : undefined,
		})),
		allHref: localizePath("/tags", locale),
		allLabel: t("nav.viewAllTags"),
	},
	{
		title: t("nav.companies"),
		links: companies.map((company) => ({
			label: companyDisplayName(company, locale),
			href: localizePath(`/company/${company.slug}`, locale),
			count: company.count,
			lang: locale === "en" && !company.nameEn ? "zh-CN" : undefined,
		})),
		allHref: localizePath("/companies", locale),
		allLabel: t("nav.viewAllCompanies"),
	},
];

const description = `${t("meta.home.description")}${t("meta.page.suffix", { page })}`;
const title = `${t("meta.home.title")}${t("meta.page.suffix", { page })}`;

const prevHref = localizePath(pagePath("/", page - 1), locale);
const nextHref = page < totalPages ? localizePath(pagePath("/", page + 1), locale) : undefined;
---

<BaseLayout
	locale={locale}
	title={title}
	description={description}
	chrome="bare"
	prevHref={prevHref}
	nextHref={nextHref}
	jsonLd={collectionJsonLd({
		name: title,
		description,
		url: new URL(localizePath(pagePath("/", page), locale), site.url).href,
		items,
	})}
>
	<IndexSheet
		locale={locale}
		kicker={t("index.kicker.all")}
		title={t("index.allTitle")}
		facts={[formatCount(locale, "articles", stats.posts), t("home.page", { page })]}
		posts={items}
		total={total}
		page={page}
		totalPages={totalPages}
		pageSize={PAGE_SIZE}
		prevHref={prevHref}
		nextHref={nextHref}
		facets={facets}
		rail={rail}
		navYearsHref={navYearsHref}
	/>
</BaseLayout>
