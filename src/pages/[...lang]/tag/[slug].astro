---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TagView from "../../../components/TagView.astro";
import {
	companiesByTag,
	openWebDatabase,
	postsByTag,
	tagBySlug,
	tagIndex,
} from "../../../lib/db/queries";
import { localizePath, localeRoutes, useTranslations } from "../../../lib/i18n";
import { isIndexableTag } from "../../../lib/tags";
import type { Locale } from "../../../lib/i18n/config";
import { PAGE_SIZE, pageCount, pagePath } from "../../../lib/pagination";
import { collectionJsonLd } from "../../../lib/structured-data";
import { site } from "../../../lib/site";

interface Props {
	locale: Locale;
}

export const getStaticPaths = (() => {
	const tags = tagIndex(openWebDatabase());
	return tags.flatMap((tag) => localeRoutes({ slug: tag.slug }));
}) satisfies GetStaticPaths;

const { locale } = Astro.props;
const t = useTranslations(locale);
const db = openWebDatabase();
const slug = String(Astro.params.slug);
const tag = tagBySlug(db, slug);

if (!tag || tag.count === 0) throw new Error(`标签不存在：${slug}`);

const companies = companiesByTag(db, slug);
const { items, total } = postsByTag(db, slug, { limit: PAGE_SIZE });
const totalPages = pageCount(total);
const title = t("meta.tag.title", { name: tag.name });
const description = t("meta.tag.description", { name: tag.name });
---

<BaseLayout
	locale={locale}
	title={title}
	description={description}
	noindex={!isIndexableTag(tag.count)}
	nextHref={totalPages > 1 ? localizePath(pagePath(`/tag/${slug}`, 2), locale) : undefined}
	jsonLd={collectionJsonLd({
		name: title,
		description,
		url: new URL(localizePath(`/tag/${slug}`, locale), site.url).href,
		items,
	})}
>
	<TagView
		locale={locale}
		tag={tag}
		companies={companies}
		posts={items}
		page={1}
		totalPages={totalPages}
		nextHref={totalPages > 1 ? localizePath(pagePath(`/tag/${slug}`, 2), locale) : undefined}
	/>
</BaseLayout>
