---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import TagView from "../../../../../components/TagView.astro";
import {
	companiesByTag,
	openWebDatabase,
	postYearsByFilters,
	postsByTag,
	tagBySlug,
	tagIndex,
} from "../../../../../lib/db/queries";
import { tagGroupOf } from "../../../../../lib/domain/tag-group";
import { localizePath, localeRoutes, useTranslations } from "../../../../../lib/i18n";
import type { Locale } from "../../../../../lib/i18n/config";
import {
	INDEX_PAGE_SIZE,
	pageCount,
	pageOffset,
	pagePath,
} from "../../../../../lib/pagination";
import { collectionJsonLd } from "../../../../../lib/structured-data";
import { site } from "../../../../../lib/site";
import { isIndexableTag } from "../../../../../lib/tags";

interface Props {
	locale: Locale;
}

export const getStaticPaths = (() => {
	const tags = tagIndex(openWebDatabase());
	return tags.flatMap((tag) => {
		const pages = pageCount(tag.count, INDEX_PAGE_SIZE);
		return Array.from({ length: Math.max(0, pages - 1) }, (_, index) => index + 2).flatMap((page) =>
			localeRoutes({ slug: tag.slug, page: String(page) }),
		);
	});
}) satisfies GetStaticPaths;

const { locale } = Astro.props;
const t = useTranslations(locale);
const db = openWebDatabase();
const slug = String(Astro.params.slug);
const page = Math.max(2, Number(Astro.params.page));
const tag = tagBySlug(db, slug);

if (!tag || tag.count === 0) throw new Error(`标签不存在：${slug}`);

const companies = companiesByTag(db, slug, 6);
const years = postYearsByFilters(db, { tagSlug: slug });
const relatedTags = tagIndex(db)
	.filter((candidate) => candidate.slug !== slug)
	.filter((candidate) => tagGroupOf(candidate.slug) === tagGroupOf(slug))
	.slice(0, 6);
const { items, total } = postsByTag(db, slug, {
	limit: INDEX_PAGE_SIZE,
	offset: pageOffset(page, INDEX_PAGE_SIZE),
});
const totalPages = pageCount(total, INDEX_PAGE_SIZE);
const navYearsHref = years[0]
	? localizePath(`/year/${years[0].year}`, locale)
	: localizePath("/tags", locale);
const title = `${t("meta.tag.title", { name: tag.name })}${t("meta.page.suffix", { page })}`;
const description = `${t("meta.tag.description", { name: tag.name })}${t("meta.page.suffix", { page })}`;

const prevHref = localizePath(pagePath(`/tag/${slug}`, page - 1), locale);
const nextHref =
	page < totalPages ? localizePath(pagePath(`/tag/${slug}`, page + 1), locale) : undefined;
---

<BaseLayout
	locale={locale}
	title={title}
	description={description}
	chrome="bare"
	noindex={!isIndexableTag(tag.count)}
	prevHref={prevHref}
	nextHref={nextHref}
	jsonLd={collectionJsonLd({
		name: title,
		description,
		url: new URL(localizePath(pagePath(`/tag/${slug}`, page), locale), site.url).href,
		items,
	})}
>
	<TagView
		locale={locale}
		tag={tag}
		companies={companies}
		relatedTags={relatedTags}
		years={years}
		posts={items}
		total={total}
		page={page}
		totalPages={totalPages}
		prevHref={prevHref}
		nextHref={nextHref}
		navYearsHref={navYearsHref}
	/>
</BaseLayout>
