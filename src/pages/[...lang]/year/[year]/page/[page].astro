---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import YearView from "../../../../../components/YearView.astro";
import { openWebDatabase, postYears, postsByYear } from "../../../../../lib/db/queries";
import { localizePath, localeRoutes, useTranslations } from "../../../../../lib/i18n";
import type { Locale } from "../../../../../lib/i18n/config";
import { PAGE_SIZE, pageCount, pageOffset, pagePath } from "../../../../../lib/pagination";
import { collectionJsonLd } from "../../../../../lib/structured-data";
import { site } from "../../../../../lib/site";

interface Props {
	locale: Locale;
}

export const getStaticPaths = (() => {
	const years = postYears(openWebDatabase());
	return years.flatMap((entry) => {
		const pages = pageCount(entry.count);
		return Array.from({ length: Math.max(0, pages - 1) }, (_, index) => index + 2).flatMap((page) =>
			localeRoutes({ year: String(entry.year), page: String(page) }),
		);
	});
}) satisfies GetStaticPaths;

const { locale } = Astro.props;
const t = useTranslations(locale);
const db = openWebDatabase();
const year = Number(Astro.params.year);
const page = Math.max(2, Number(Astro.params.page));
const yearRow = postYears(db).find((entry) => entry.year === year);

if (!yearRow) throw new Error(`年份不存在：${year}`);

const { items, total } = postsByYear(db, year, { limit: PAGE_SIZE, offset: pageOffset(page) });
const totalPages = pageCount(total);
const title = `${t("meta.year.title", { year })}${t("meta.page.suffix", { page })}`;
const description = `${t("meta.year.description", { year })}${t("meta.page.suffix", { page })}`;

const prevHref = localizePath(pagePath(`/year/${year}`, page - 1), locale);
const nextHref =
	page < totalPages ? localizePath(pagePath(`/year/${year}`, page + 1), locale) : undefined;
---

<BaseLayout
	locale={locale}
	title={title}
	description={description}
	prevHref={prevHref}
	nextHref={nextHref}
	jsonLd={collectionJsonLd({
		name: title,
		description,
		url: new URL(localizePath(pagePath(`/year/${year}`, page), locale), site.url).href,
		items,
	})}
>
	<YearView
		locale={locale}
		year={year}
		count={yearRow.count}
		posts={items}
		page={page}
		totalPages={totalPages}
		prevHref={prevHref}
		nextHref={nextHref}
	/>
</BaseLayout>
